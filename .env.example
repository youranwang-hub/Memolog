# Supabase — 在 https://supabase.com 创建项目，Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__your-anon-key

# DeepSeek API — https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Invite-only signup
INVITE_CODE=your-private-invite-code

# Personal-site publishing — server only. Set ONE owner identifier in Vercel.
MEMOLOG_PERSONAL_SITE_OWNER_USER_ID=your-supabase-user-id
# MEMOLOG_PERSONAL_SITE_OWNER_EMAIL=you@example.com
# GitHub fine-grained token: Contents read/write for youranwang-hub/personal-website only.
GITHUB_PERSONAL_SITE_TOKEN=github_pat_your-token
GITHUB_PERSONAL_SITE_REPO=youranwang-hub/personal-website
GITHUB_PERSONAL_SITE_BRANCH=main
